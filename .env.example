# ============================================
# 이음(ieum) 환경 변수 설정 파일
# ============================================
# 이 파일을 복사하여 .env 파일을 만들고, 실제 값을 채워주세요.
# cp .env.example .env
#
# ⚠️ .env 파일은 .gitignore에 의해 Git에 추적되지 않습니다.
# ⚠️ 절대로 실제 키를 .env.example에 적지 마세요!
# ============================================

# ----- 공공데이터포털 (한국관광공사 TourAPI) -----
TOUR_API_SERVICE_KEY=여기에_공공데이터포털_인증키를_입력하세요
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# ----- PostgreSQL Database -----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ieum
SPRING_DATASOURCE_USERNAME=ieum
DB_PASSWORD=여기에_DB_비밀번호를_입력하세요

# ----- JWT -----
JWT_SECRET=여기에_JWT_시크릿키를_입력하세요

# ----- iron-session (BFF) -----
SESSION_SECRET=여기에_세션_시크릿키를_입력하세요

# ----- Backend URL (Frontend → Backend) -----
BACKEND_URL=http://localhost:8080
